{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport firebase from 'firebase';\nexport default {\n  methods: {\n    login() {\n      var provider = new firebase.auth.GoogleAuthProvider();\n      provider.addScope('https://www.googleapis.com/auth/contacts.readonly');\n      firebase.auth().signInWithPopup(provider).then(result => {\n        /** @type {firebase.auth.OAuthCredential} */\n        var credential = result.credential; // This gives you a Google Access Token. You can use it to access the Google API.\n\n        var token = credential.accessToken; // The signed-in user info.\n\n        var user = result.user;\n        this.$router.push('/'); // ...\n      }).catch(error => {\n        // Handle Errors here.\n        var errorCode = error.code;\n        var errorMessage = error.message; // The email of the user's account used.\n\n        var email = error.email; // The firebase.auth.AuthCredential type that was used.\n\n        var credential = error.credential; // ...\n      });\n    }\n\n  }\n};","map":{"version":3,"mappings":";AAgGI,OAAOA,QAAP,MAAqB,UAArB;AACA,eAAc;EACVC,OAAO,EAAC;IACJC,KAAK,GAAE;MACH,IAAIC,QAAO,GAAI,IAAIH,QAAQ,CAACI,IAAT,CAAcC,kBAAlB,EAAf;MACAF,QAAQ,CAACG,QAAT,CAAkB,mDAAlB;MACAN,QAAQ,CAACI,IAAT,GACKG,eADL,CACqBJ,QADrB,EAEKK,IAFL,CAEWC,MAAD,IAAY;QACd;QACA,IAAIC,UAAS,GAAID,MAAM,CAACC,UAAxB,CAFc,CAId;;QACA,IAAIC,KAAI,GAAID,UAAU,CAACE,WAAvB,CALc,CAMd;;QACA,IAAIC,IAAG,GAAIJ,MAAM,CAACI,IAAlB;QAEA,KAAKC,OAAL,CAAaC,IAAb,CAAkB,GAAlB,EATc,CAUd;MACH,CAbL,EAaOC,KAbP,CAacC,KAAD,IAAW;QAChB;QACA,IAAIC,SAAQ,GAAID,KAAK,CAACE,IAAtB;QACA,IAAIC,YAAW,GAAIH,KAAK,CAACI,OAAzB,CAHgB,CAIhB;;QACA,IAAIC,KAAI,GAAIL,KAAK,CAACK,KAAlB,CALgB,CAMhB;;QACA,IAAIZ,UAAS,GAAIO,KAAK,CAACP,UAAvB,CAPgB,CAQhB;MACH,CAtBL;IAuBJ;;EA3BI;AADE,CAAd","names":["firebase","methods","login","provider","auth","GoogleAuthProvider","addScope","signInWithPopup","then","result","credential","token","accessToken","user","$router","push","catch","error","errorCode","code","errorMessage","message","email"],"sourceRoot":"","sources":["C:\\Users\\aphel\\Vue CLI projects\\realtime-chat\\src\\views\\login.vue"],"sourcesContent":["<template>\r\n    <div class=\"box\">\r\n        <div class=\"logo\">\r\n\r\n        </div>\r\n    <h2>Sign In</h2>\r\n    <p>Use your Google Account</p>\r\n    <div class=\"center-block\">\r\n    <input  type=\"submit\" name=\"sign-in\" value=\"Sign In\">\r\n    </div>\r\n    </div>\r\n</template>\r\n<style scoped>\r\n    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&display=swap');\r\n\r\n\r\n body {\r\n     margin: 0;\r\n     padding: 0;\r\n     background-size: cover;\r\n     font-family: 'Open Sans', sans-serif;\r\n }\r\n\r\n .box {\r\n     position: absolute;\r\n     top: 50%;\r\n     left: 50%;\r\n     transform: translate(-50%, -50%);\r\n     width: 30rem;\r\n     padding: 3.5rem;\r\n     box-sizing: border-box;\r\n     border: 1px solid #dadce0;\r\n     -webkit-border-radius: 8px;\r\n     border-radius: 8px;\r\n\r\n }\r\n\r\n .box h2 {\r\n     margin: 0px 0 -0.125rem;\r\n     padding: 0;\r\n     text-align: center;\r\n     color: #202124;\r\n     font-size: 24px;\r\n     font-weight: 400;\r\n }\r\n\r\n .box .logo\r\n {\r\n     display: flex;\r\n     flex-direction: row;\r\n     justify-content: center;\r\n     margin-bottom: 16px;\r\n\r\n }\r\n\r\n .box p {\r\n     font-size: 16px;\r\n     font-weight: 400;\r\n     letter-spacing: 1px;\r\n     line-height: 1.5;\r\n     margin-bottom: 24px;\r\n     text-align: center;\r\n }\r\n\r\n\r\n\r\n .box .inputBox input:focus {\r\n     outline: none;\r\n     border: 2px solid #1a73e8;\r\n }\r\n\r\n .box input[type=\"submit\"] {\r\n     border: none;\r\n     outline: none;\r\n     color: #fff;\r\n     background-color: #1a73e8;\r\n     padding: 0.625rem 1.25rem;\r\n     cursor: pointer;\r\n     border-radius: 0.312rem;\r\n     font-size: 1rem;\r\n     display: inline-block;\r\n\r\n   }\r\n\r\n   .box input[type=\"submit\"]:hover {\r\n     background-color: #287ae6;\r\n     box-shadow: 0 1px 1px 0 rgba(66,133,244,0.45), 0 1px 3px 1px rgba(66,133,244,0.3);\r\n   }\r\n   .center-block {\r\n  display: block;\r\n  margin-right: auto;\r\n  margin-left: auto;\r\n}\r\n\r\n</style>\r\n<script>\r\n    import firebase from 'firebase'\r\n    export default{\r\n        methods:{\r\n            login(){\r\n                var provider = new firebase.auth.GoogleAuthProvider();\r\n                provider.addScope('https://www.googleapis.com/auth/contacts.readonly');\r\n                firebase.auth()\r\n                    .signInWithPopup(provider)\r\n                    .then((result) => {\r\n                        /** @type {firebase.auth.OAuthCredential} */\r\n                        var credential = result.credential;\r\n\r\n                        // This gives you a Google Access Token. You can use it to access the Google API.\r\n                        var token = credential.accessToken;\r\n                        // The signed-in user info.\r\n                        var user = result.user;\r\n\r\n                        this.$router.push('/')\r\n                        // ...\r\n                    }).catch((error) => {\r\n                        // Handle Errors here.\r\n                        var errorCode = error.code;\r\n                        var errorMessage = error.message;\r\n                        // The email of the user's account used.\r\n                        var email = error.email;\r\n                        // The firebase.auth.AuthCredential type that was used.\r\n                        var credential = error.credential;\r\n                        // ...\r\n                    });\r\n            }\r\n        }\r\n    }\r\n</script>"]},"metadata":{},"sourceType":"module"}